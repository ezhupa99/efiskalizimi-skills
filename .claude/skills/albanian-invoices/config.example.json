{
  "_note": "Shape only. The invoice-setup skill writes the real file to ~/.albanian-invoices/config.json. Never share that file.",
  "first_run": true,
  "portal_defaults": {
    "product": {
      "name_pattern": "<product_prefix> - <Albanian month> - <year>",
