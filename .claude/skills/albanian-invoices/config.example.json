      "portal_currency_label": "Euro",
      "billing": "fixed",
      "fixed_amount": 0,
      "transfer_fee": 0,
      "fee_paid_by": "client",
      "payment_date_rule": "end of current month",
      "supply_date_rule": "end of current month",
      "notes": "",
