    },
    {
      "id": "example",
      "name": "Example Inc",
      "product_prefix": "Example",
      "buyer_id": "<tax/registration id>",
      "country": "Shtetet e Bashkuara te Amerikes",
      "city": "<city>",
      "address": "<street address>",
      "currency": "USD",
      "portal_currency_label": "Dollar Amerikan",
      "billing": "hourly",
      "unit_price": 0,
      "transfer_fee": 0,
      "fee_paid_by": "freelancer",
      "payment_date_rule": "20th of next month",
      "supply_date_rule": "end of current month",
      "notes": "",
      "client_invoice": {
        "tool": "canva",
        "design_name": "<your Canva design name>",
